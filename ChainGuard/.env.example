# docker compose 使用 POSTGRES_* 拼出 DATABASE_URL；本地非容器开发可单独设置 DATABASE_URL。
POSTGRES_DB=chainguard
POSTGRES_USER=chainguard
POSTGRES_PASSWORD=请替换为高强度数据库密码
JWT_SECRET=请替换为至少32位随机字符串
# JWT 轮换灰度期内保留旧 HS256 密钥；逗号分隔，仅用于验签，签发仍只使用 JWT_SECRET。
JWT_SECRET_PREVIOUS=
SEED_DEMO_PASSWORD=请设置演示账号密码
API_WORKERS=4
REFRESH_COOKIE_SECURE=false
TZ=Asia/Shanghai
DATABASE_URL=sqlite:///./chainguard.db
DATABASE_CONNECT_TIMEOUT=3
JWT_ALGORITHM=HS256
JWT_RS256_PUBLIC_KEY=
# RS256 轮换灰度期内保留旧公钥；逗号分隔，仅用于验签。
JWT_RS256_PUBLIC_KEY_PREVIOUS=
JWT_RS256_PRIVATE_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:8000,http://localhost:8080
WEBHOOK_URL=
WEBHOOK_REMOTE_ENABLED=false
MAX_IMPORT_BYTES=20971520

# ------------------------------------------------------------------ 多 worker 部署
# 限流计数桶的存储位置。API 默认 4 个 worker，进程内计数桶会让每个 worker 各算
# 各的——名义 5/minute 的登录限流实际变成 20/minute，且重启即清零。
# docker compose 已默认指向内置 redis 服务，一般无需在这里覆盖。
#
# 未设置时的行为是显式裁决的（src/webapi/limits.py）：
#   * DATABASE_URL 是 SQLite（本地开发 / start-demo 单进程）→ 自动退回 memory://
#   * 其它后端（判定为生产部署）→ 拒绝启动，绝不静默退化成假限流
# 确知单进程运行又用了非 SQLite 后端时，显式写 memory:// 以承担该风险。
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
#
# 启动时把超过该分钟数仍处于 pending/running 的作业判死（进程崩溃遗留的僵尸作业会永久
# 占住该事件的决策入口）。必须显著大于决策作业自身 60s 的执行超时预算。
JOB_RECOVERY_STALE_MINUTES=15
# 关闭启动期作业回收（演示/e2e 需要完全确定性时）。
CHAINGUARD_DISABLE_JOB_RECOVERY=false
# Durable database-backed job workers. A submitted job stores its computed
# budget (base + rows/1000, capped), so restart and cross-process claims use
# the same tenant/data-volume limit.
JOB_POLL_SECONDS=0.25
JOB_SHUTDOWN_GRACE_SECONDS=30
JOB_RETRY_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=2
JOB_RETRY_BACKOFF_MAX_SECONDS=60
DECISION_JOB_TIMEOUT_SECONDS=60
IMPORT_JOB_TIMEOUT_SECONDS=30
JOB_TIMEOUT_PER_1000_ROWS_SECONDS=5
JOB_TIMEOUT_MAX_SECONDS=300
# Phase 5B 本地图片 OCR（RapidOCR + ONNX Runtime）；无需 API 密钥或本机模型路径。
CHAINGUARD_OCR_ENABLED=true
CHAINGUARD_OCR_TIMEOUT_SECONDS=20
CHAINGUARD_OCR_MIN_CONFIDENCE=0.75
CHAINGUARD_OCR_MAX_PIXELS=25000000

# 凭证加密主密钥。**必填**：凭证加密是 fail-closed 的，缺失会导致服务拒绝启动。
CHAINGUARD_ENCRYPTION_KEY=请替换为至少32位随机字符串

# ---------------------------------------------------------------- 解释文案生成（可选）
# 不配置时解释文案走确定性模板：系统功能完整、数值一致，只是措辞固定。
#
# 后端选择顺序：CHAINGUARD_LLM_PROVIDER > 有 DEEPSEEK_API_KEY 则 deepseek > 否则本地 ollama。
# 想强制走本地模型/模板时填 ollama。
# CHAINGUARD_LLM_PROVIDER=deepseek

# DeepSeek API key（https://platform.deepseek.com 获取）。
# 填在 .env 里即可，不要写进任何其它文件——.env 已被 .gitignore 排除，其它文件不一定。
DEEPSEEK_API_KEY=
# 以下一般不用改
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
