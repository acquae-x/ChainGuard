{
  "name": "chainguard-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChainGuard 企业级供应链中断应急决策 SaaS 前端",
  "scripts": {
    "dev": "vite",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && npm run dev",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/generate-route-access-map.cjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=low",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:gate": "node scripts/run-acceptance-gate.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "6.6.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "tslib": "2.8.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.11",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.0",
    "cross-env": "7.0.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
